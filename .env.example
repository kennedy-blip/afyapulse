# Optional: absolute URL to a compiled Android APK (GitHub release asset, CDN, etc.)
# When unset the app probes ./downloads/afyapulse.apk next to the deployed bundle.
VITE_APK_URL=

# Optional: owner/repo used for the "Build via GitHub Actions" link in the APK centre.
VITE_GITHUB_REPO=kennedy-blip/afyapulse
